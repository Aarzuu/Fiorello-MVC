@model Blog

<main>
    <section id="blog-detail" class="py-5" style="margin-top: 100px;">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="section-title text-center mb-5">
                        <h1>@Model.Caption</h1>
                        <p class="text-black-50">@Model.CreatedDate</p>
                    </div>

                    <div class="img text-center mb-5">
                        @{
                            var mainImg = Model.BlogImages?.FirstOrDefault(im => im.IsMain)?.Image;
                        }
                        <img src="/assets/img/@mainImg" class="img-fluid" style="max-height: 500px; width: 100%; object-fit: cover;" alt="">
                    </div>

                    <div class="text px-lg-5">
                        <p class="text-black-50" style="font-size: 1.2rem; line-height: 2;">
                            @Model.Context
                        </p>
                    </div>

                    <div class="row mt-5">
                        @foreach (var item in Model.BlogImages.Where(im => !im.IsMain))
                        {
                            <div class="col-md-4 mb-4">
                                <div class="item">
                                    <img src="/assets/img/@item.Image" class="img-fluid rounded" alt="">
                                </div>
                            </div>
                        }
                    </div>

                    <div class="text-center mt-5">
                        <a asp-controller="Blog" asp-action="Index" class="btn btn-outline-danger px-5">Back to Blog</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>