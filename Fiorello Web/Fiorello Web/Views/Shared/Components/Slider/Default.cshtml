
@model SliderVMVC
<section id="slider">
    <div class="owl-carousel slider">
        @foreach (var i in Model.Sliders.Take(3))
        {
            <div> <img src="assets/img/@i.Image" alt=""> </div>
        }
    </div>
    <div class="container context pl-lg-5 ml-lg-3">
        <div class="row">
            <div class="col-lg-5">
                <div class="text">
                    <h1>@Model.SliderContext.Heading</h1>
                    <p class="text-black-50 d-none d-sm-block">@Model.SliderContext.Paragraph</p>
                </div>
                <div class="img">
                    <img src="assets/img/@Model.SliderContext.Image" alt="">
                </div>
            </div>
        </div>
    </div>
</section>