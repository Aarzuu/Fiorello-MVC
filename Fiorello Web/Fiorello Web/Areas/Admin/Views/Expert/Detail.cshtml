
@model ExpertDetailVM

@{
    ViewData["Title"] = "Detail";
}

<div class="item text-center">
    <div class="img">
        <img src="/assets/img/@Model.Image" class="img-fluid rounded-circle" alt="" style="max-width:250px; max-height:250px">
    </div>
    <div class="text mt-3">
        <h6>@Model.Name</h6>
        <p class="text-black-50">@Model.Profession</p>
    </div>
    <a class="btn btn-warning"asp-action="Index">Back</a>
</div>